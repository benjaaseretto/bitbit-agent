# bitbit-agent — Pipecat runtime

AGENT_NAME=bitbit

# LLM DeepSeek-V4.1-Flash (set your key in .env — never commit it)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Whisper STT: whisper-http (default, docker :8000) | mlx (local Apple Silicon)
STT_ENGINE=whisper-http
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=whisper-1
WHISPER_API_KEY=not-needed

# TTS: kokoro (in-process, reliable) | chatterbox (docker :4123)
TTS_ENGINE=kokoro
KOKORO_VOICE=ef_dora
# Velocidad (0.5–2.0) y volumen lineal (0.1–2.0); Mac/Qwen también los usa
TTS_SPEED=1.0
TTS_VOLUME=1.0
# Optional Chatterbox:
# TTS_ENGINE=chatterbox
# CHATTERBOX_BASE_URL=http://localhost:4123/v1
# CHATTERBOX_VOICE=ana_es
# CHATTERBOX_LANGUAGE=es
# CHATTERBOX_API_KEY=not-needed

# Call metadata (optional; defaults to presets/demo_call.json)
# BITBIT_METADATA_FILE=presets/demo_call.json
# BITBIT_METADATA_JSON=

# Transport:
#   python -m app.pipecat_runtime.bot --transport webrtc
# Daily (optional):
# DAILY_API_KEY=
# DAILY_SAMPLE_ROOM_URL=
