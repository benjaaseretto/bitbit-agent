# bitbit-agent — Pipecat runtime

AGENT_NAME=bitbit

# LLM DeepSeek-V4.1-Flash (set your key in .env — never commit it)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Whisper STT: whisper-http (default, docker :8000) | mlx (local Apple Silicon)
STT_ENGINE=whisper-http
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=whisper-1
WHISPER_API_KEY=not-needed

# TTS: kokoro (in-process, reliable) | chatterbox (docker :4123)
TTS_ENGINE=kokoro
KOKORO_VOICE=ef_dora
# Velocidad (0.5–2.0) y volumen lineal (0.1–2.0); Mac/Qwen también los usa
TTS_SPEED=1.0
TTS_VOLUME=1.0
# Optional Chatterbox:
# TTS_ENGINE=chatterbox
# CHATTERBOX_BASE_URL=http://localhost:4123/v1
# CHATTERBOX_VOICE=ana_es
# CHATTERBOX_LANGUAGE=es
# CHATTERBOX_API_KEY=not-needed

# Call metadata: JSON base + TEST_* (como colly). TEST_* pisa el JSON.
# BITBIT_METADATA_FILE=presets/bio_analyze_call.json
# BITBIT_METADATA_FILE=presets/demo_call.json
# TEST_METADATA_SOURCE=json   # json | env | redis

# BioAnalyze — camino más complejo (mora 91–239):
# BITBIT_FLOW_KEY=bio_analyze_flow
# TEST_FLOW_KEY=bio_analyze_flow
# TEST_NAME=Carla Méndez
# TEST_COMPANY_NAME=BioAnalyze
# TEST_PRODUCTO=analizador hematológico XS-500
# TEST_CANTIDAD=2
# TEST_SUCURSAL=depósito Norte
# TEST_FINANCIAMIENTO=contado o 6 cuotas
# TEST_TOTAL_BALANCE=18500
# TEST_DUE_BALANCE=18500
# TEST_AMOUNT=18500
# TEST_DUE_DATE=2026-05-22
# TEST_DELINQUENCY=120
# TEST_MAX_DISCOUNT_PCT=40
# TEST_MIN_PAGO_PCT=60
# TEST_MAX_DIAS=15

TEST_NAME=Juan Pérez
TEST_NOMBRE_AGENTE=Ana
TEST_COMPANY_NAME=Clínica Vida
TEST_ESPECIALIDAD=medicina general
TEST_NOMBRE_MEDICO=la doctora López
TEST_SUCURSAL=sucursal Centro
TEST_FECHA_TURNO=mañana
TEST_HORA_TURNO=10:00
TEST_FRANJA_TURNO=mañana
TEST_MAX_COMMITMENT_DAYS=7
TEST_TIMEZONE=America/Mexico_City
# Redis opcional:
# TEST_METADATA_SOURCE=redis
# TEST_REDIS_URL=redis://localhost:6379/0
# TEST_REDIS_KEY_PREFIX=dev:calls
# TEST_CALL_ID=1
# python scripts/seed_call.py --redis

# Flujo a probar (platform_flow_key). Lista: app/flow_graph/specs/INDEX.md
BITBIT_FLOW_KEY=clinica_vida_flow
# BITBIT_FLOW_KEY=bio_analyze_flow
# BITBIT_FLOW_KEY=aurora_salud_flow
# BITBIT_FLOW_KEY=tecno_medico_flow

# Mac parlantes: 0 = no cortar el TTS (eco del mic). Headphones: 5
VAD_START_SECS=0.35
VAD_STOP_SECS=0.45
INTERRUPTION_MIN_WORDS=0

# Transport:
#   python -m app.pipecat_runtime.bot --transport webrtc
# Daily (optional):
# DAILY_API_KEY=
# DAILY_SAMPLE_ROOM_URL=
