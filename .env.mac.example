# Perfil Mac (MLX audio + DeepSeek LLM). Copiar a .env.mac
# cp .env.mac.example .env.mac

# --- LLM (default: DeepSeek API) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# A/B opcional: LLM_PROVIDER=mlx + servidor local
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# --- STT / TTS locales (Apple Silicon) ---
# whisper-mlx: más estable en español con mic+parlantes.
# parakeet: más rápido, pero alucina con eco/ruido.
STT_ENGINE=whisper-mlx
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
WHISPER_MLX_MODEL=mlx-community/whisper-small-mlx

# preset = voz de prueba; clone = referencia humana
TTS_VOICE_MODE=preset
QWEN_TTS_VOICE=Serena
# Otras: Vivian Ryan Aiden Ono_Anna Sohee Uncle_Fu  (ver docs/VOICES.md)
# python scripts/list_voices.py --set Vivian
QWEN_TTS_REFERENCE_AUDIO=
QWEN_TTS_REFERENCE_TEXT=
TTS_STREAMING_INTERVAL=0.32

# Velocidad y volumen de la voz (Mac / Qwen-TTS)
# TTS_SPEED: 0.5=lento … 1.0=normal … 1.3=rápido (máx 2.0)
# TTS_VOLUME: 0.5=bajo … 1.0=normal … 1.5=alto (máx 2.0)
TTS_SPEED=1.0
TTS_VOLUME=1.0

# Flujo a probar (platform_flow_key). Lista: app/flow_graph/specs/INDEX.md
BITBIT_FLOW_KEY=bio_analyze_flow
# BITBIT_FLOW_KEY=clinica_vida_flow
# BITBIT_FLOW_KEY=aurora_salud_flow
# BITBIT_FLOW_KEY=tecno_medico_flow

# Variables de prueba (TEST_* pisan presets/bio_analyze_call.json)
BITBIT_METADATA_FILE=presets/bio_analyze_call.json
TEST_FLOW_KEY=bio_analyze_flow
TEST_NAME=Carla Méndez
TEST_NOMBRE_AGENTE=Ana
TEST_COMPANY_NAME=BioAnalyze
TEST_PRODUCTO=analizador hematológico XS-500
TEST_CANTIDAD=2
TEST_SUCURSAL=depósito Norte
TEST_FINANCIAMIENTO=contado o 6 cuotas
TEST_TOTAL_BALANCE=18500
TEST_DUE_BALANCE=18500
TEST_AMOUNT=18500
TEST_DUE_DATE=2026-05-22
TEST_DELINQUENCY=120
TEST_MAX_DISCOUNT_PCT=40
TEST_MIN_PAGO_PCT=60
TEST_MAX_DIAS=15
TEST_MAX_COMMITMENT_DAYS=15
TEST_TIMEZONE=America/Mexico_City
# TEST_METADATA_SOURCE=json
# TEST_REDIS_URL=redis://localhost:6379/0
# python scripts/seed_call.py --redis


# 0 = no barge-in mientras habla (parlantes). Headphones: 5
VAD_START_SECS=0.35
VAD_STOP_SECS=0.45
INTERRUPTION_MIN_WORDS=0
