# Perfil Mac (MLX audio + DeepSeek LLM). Copiar a .env.mac
# cp .env.mac.example .env.mac

# --- LLM (default: DeepSeek API) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-16e24c7e57804b9fb78012ccb87fa6bb
DEEPSEEK_MODEL=deepseek-flash

# A/B opcional: LLM_PROVIDER=mlx + servidor local
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# --- STT / TTS locales (Apple Silicon) ---
# whisper-mlx: más estable en español con mic+parlantes.
# parakeet: más rápido, pero alucina con eco/ruido.
STT_ENGINE=whisper-mlx
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
WHISPER_MLX_MODEL=mlx-community/whisper-small-mlx

# preset = voz de prueba; clone = referencia humana
TTS_VOICE_MODE=preset
QWEN_TTS_VOICE=Serena
# Otras: Vivian Ryan Aiden Ono_Anna Sohee Uncle_Fu  (ver docs/VOICES.md)
# python scripts/list_voices.py --set Vivian
QWEN_TTS_REFERENCE_AUDIO=
QWEN_TTS_REFERENCE_TEXT=
TTS_STREAMING_INTERVAL=0.32

# Velocidad y volumen de la voz (Mac / Qwen-TTS)
# TTS_SPEED: 0.5=lento … 1.0=normal … 1.3=rápido (máx 2.0)
# TTS_VOLUME: 0.5=bajo … 1.0=normal … 1.5=alto (máx 2.0)
TTS_SPEED=1.0
TTS_VOLUME=1.0

VAD_START_SECS=0.25
VAD_STOP_SECS=0.35
INTERRUPTION_MIN_WORDS=3
